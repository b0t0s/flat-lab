    @metube host metube.{$DUCKDNS_DOMAIN}
    handle @metube {
        reverse_proxy metube:8081
    }

    @tools host tools.{$DUCKDNS_DOMAIN}
    handle @tools {
        reverse_proxy it-tools:80
    }

    @git host git.{$DUCKDNS_DOMAIN}
    handle @git {
        request_body {
            max_size 512MiB
        }
        reverse_proxy onedev:6610 {
            header_up Host {upstream_hostport}
            header_up X-Forwarded-Host {host}
        }
    }

    @phatcrack host phatcrack.{$DUCKDNS_DOMAIN}
    handle @phatcrack {
        encode gzip

        header {
            Strict-Transport-Security max-age=31536000;
            X-Content-Type-Options nosniff
            X-Frame-Options DENY
            Referrer-Policy no-referrer-when-downgrade
        }

        handle /agent-assets/* {
            reverse_proxy agent-server:80
        }
        handle /api/* {
            header Content-Security-Policy "default-src 'none'"
            reverse_proxy phatcrack-api:3000
        }
        handle {
            header Content-Security-Policy "default-src 'self'; object-src 'none'; script-src 'self' 'unsafe-eval'; img-src 'self' data:; style-src 'self' data: 'unsafe-inline'"
            reverse_proxy phatcrack-frontend:80
        }
    }

    # Fallback
    handle {
        abort
    }
}