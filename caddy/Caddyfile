*.{$DUCKDNS_DOMAIN} {
    tls {
        dns duckdns {$DUCKDNS_TOKEN}
        resolvers 1.1.1.1 8.8.8.8
    }

    @dash host dash.{$DUCKDNS_DOMAIN}
    handle @dash {
        reverse_proxy homepage:3000
    }

    @status host status.{$DUCKDNS_DOMAIN}
    handle @status {
        reverse_proxy uptime-kuma:3001
    }

    @logs host logs.{$DUCKDNS_DOMAIN}
    handle @logs {
        reverse_proxy dozzle:8080
    }

    @netalertx host netalertx.{$DUCKDNS_DOMAIN}
    handle @netalertx {
        encode gzip
        reverse_proxy host.docker.internal:20211 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    @adguard host adguard.{$DUCKDNS_DOMAIN}
    handle @adguard {
        reverse_proxy adguardhome:81
    }

    @ai host ai.{$DUCKDNS_DOMAIN}
    handle @ai {
        reverse_proxy open-webui:8080
    }

    @memos host memos.{$DUCKDNS_DOMAIN}
    handle @memos {
        reverse_proxy memos:5230
    }

    @blog host blog.{$DUCKDNS_DOMAIN}
