    @phatcrack host phatcrack.{$DUCKDNS_DOMAIN}
    handle @phatcrack {
        encode gzip

        header {
            Strict-Transport-Security max-age=31536000;
            X-Content-Type-Options nosniff
            X-Frame-Options DENY
            Referrer-Policy no-referrer-when-downgrade
        }

        handle /agent-assets/* {
            reverse_proxy agent-server:80
        }
        handle /api/* {
            header Content-Security-Policy "default-src 'none'"
            reverse_proxy phatcrack-api:3000
        }
        handle {
            header Content-Security-Policy "default-src 'self'; object-src 'none'; script-src 'self' 'unsafe-eval'; img-src 'self' data:; style-src 'self' data: 'unsafe-inline'"
            reverse_proxy phatcrack-frontend:80
        }
    }

