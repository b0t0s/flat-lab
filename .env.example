# .env.example - copy to .env and fill in real values.
# All tokens, passwords, network IDs, URLs, hostnames, and accounts are placeholders.
# Only port numbers and non-credential defaults (e.g. UID:GID) are kept.

## =========================================
## COMPOSE PROFILES (category gating)
## =========================================
# Enabled by default. Add or remove categories to control which services start.
# Available: system,dashboard,network,media,photos,knowledge,secrets,finance,
# productivity,dev,smarthome,family,medical,chat,paas
COMPOSE_PROFILES=system,dashboard,network,media,photos,knowledge,finance,productivity,dev,smarthome,chat,paas,monitor,bookmarks,tools

