# .env.example - copy to .env and fill in real values.
# All tokens, passwords, network IDs, URLs, hostnames, and accounts are placeholders.
# Only port numbers and non-credential defaults (e.g. UID:GID) are kept.

## =========================================
## CORE SYSTEM & PROXY SETTINGS
## =========================================
DUCKDNS_TOKEN=__PLACEHOLDER_TOKEN__
ZEROTIER_NETWORK_ID=__PLACEHOLDER_NETWORK_ID__
DUCKDNS_DOMAIN=__PLACEHOLDER_URL__
LAN_HOST=__PLACEHOLDER_URL__

## =========================================
## ADGUARD HOME
## =========================================
ADGUARD_DNS_TCP_PORT=53
ADGUARD_DNS_UDP_PORT=53
ADGUARD_HTTP_PORT=81
ADGUARD_WEB_PORT=3000

## =========================================
## AI STACK (Ollama + OpenWebUI)
## =========================================
OPEN_WEBUI_HOST_PORT=3020

## =========================================
## ARCHIVEBOX (Web Archiver)
## =========================================
ARCHIVEBOX_HOST_PORT=8001
ARCHIVEBOX_ADMIN_USER=__PLACEHOLDER_USER__
ARCHIVEBOX_ADMIN_PASS=__PLACEHOLDER_PASSWORD__

## =========================================
## ONEDEV (Git & CI/CD)
## =========================================
ONEDEV_PORT1=6610
ONEDEV_PORT2=6611

## =========================================
## PHATCRACK STACK
## =========================================
DB_PASS=__PLACEHOLDER_PASSWORD__
PHATCRACK_USER=999:991
HOST_NAME=__PLACEHOLDER_URL__
BASE_URL=__PLACEHOLDER_URL__

## =========================================
## SEAFILE (Block-based Cloud Storage)
## =========================================
SEAFILE_HOST_PORT=8084
SEAFILE_DB_ROOT_PASS=__PLACEHOLDER_PASSWORD__
SEAFILE_ADMIN_EMAIL=__PLACEHOLDER_EMAIL__
SEAFILE_ADMIN_PASS=__PLACEHOLDER_PASSWORD__

## =========================================
## RUSTDESK (Remote Desktop Infrastructure)
## =========================================
RUSTDESK_RELAY_IP=__PLACEHOLDER_URL__

## =========================================
## DASHBOARDS & MONITORING
## =========================================
UPTIME_KUMA_PORT=3001
DOZZLE_PORT=8888
DOZZLE_USER=__PLACEHOLDER_USER__
DOZZLE_EMAIL=__PLACEHOLDER_EMAIL__
DOZZLE_PASSWORD=__PLACEHOLDER_PASSWORD__
HOMEPAGE_PORT=3015

## =========================================
## MEDIA & READING STACK PORTS
## =========================================
NAVIDROME_HOST_PORT=4533
KAVITA_HOST_PORT=5002
NODERED_HOST_PORT=1880
GHOST_HOST_PORT=2368
MEMOS_HOST_PORT=5230
CHANGEDETECTION_HOST_PORT=5000

## =========================================
## DATABASES PASSWORDS (Ghost)
## =========================================
GHOST_DB_ROOT_PASS=__PLACEHOLDER_PASSWORD__
GHOST_DB_PASS=__PLACEHOLDER_PASSWORD__

## =========================================
## MISCELLANEOUS PORTS (Optional overrides)
## =========================================
CALIBRE_HOST_PORT=8083
HOMEBOX_HOST_PORT=3100
ITTOOLS_HOST_PORT=8082
PROWLARR_HOST_PORT=9696
QBITTORRENT_WEB_PORT=8080
QBITTORRENT_TORRENT_PORT=6881
METUBE_HOST_PORT=8081
PINGVIN_HOST_PORT=3010
ZTNCUI_HOST_PORT=3443
